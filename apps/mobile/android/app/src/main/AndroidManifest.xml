<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Permissions are declared here; each one is *requested* only when the user
      reaches the feature that needs it, behind an in-app rationale screen
      (Development_Plan/conventions/Permission_Model.md). Declaring a permission
      does not grant it - every entry below still requires explicit opt-in.

      The accessibility service and the automation foreground service are declared
      in the library modules that own them (android/accessibility and
      android/automation) and arrive in this manifest by manifest merge once those
      modules are wired into the app by the Turbo Module bridge in Phase 3.
    -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Keeps a user-initiated automation alive while the user is in another app.
      SPECIAL_USE is required from API 34 because keeping accessibility-driven
      automation running is not one of Android's predefined service types; the
      justification is declared on the service itself.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- The persistent "automation is running" notification, and workflow results. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Draws the Configure-with-AI toolset over other apps (Phase 8). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Resolves a person by name for goals such as "message Robert". Read-only. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!--
      Reliable foreground-app detection (Step 2). This is an appop-guarded
      permission: declaring it here is necessary but not sufficient, and
      `checkSelfPermission` returns granted purely because of this line - which is
      why the capability is read through AppOpsManager instead. The user grants it
      in Settings > Special app access > Usage access.
    -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
      Lets the app be offered as the device assistant. The voice-interaction
      services themselves live in android/assistant and arrive by manifest merge;
      without them the app never appears in the assistant picker at all.
    -->
    <uses-permission android:name="android.permission.BIND_VOICE_INTERACTION"
        tools:ignore="ProtectedPermissions" />


    <!-- Time-based triggers and the createAlarm tool. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!--
      Required for the createAlarm tool to set an alarm *without* opening the clock
      app. `AlarmClock.EXTRA_SKIP_UI` is honoured only for callers holding this
      permission; without it the clock app opens pre-filled and waits for a tap,
      which for an agent working in the background means the alarm is never set and
      the tool still reports success.

      Normal-level, so it is granted at install and needs no request.
    -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!--
      Sending and reading text messages, so a task such as "text Robert that I am
      running late" sends rather than leaving a draft in the messaging app.

      One permission group as far as the runtime dialog is concerned: asking for
      either shows the same "Send and view SMS messages" prompt, which is why the
      capability registry models them as one capability rather than two toggles the
      platform cannot honour separately.
    -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <!--
      Placing a call directly, rather than opening the dialer pre-filled and waiting
      for a tap. Requested at the moment of use, with a rationale that says plainly
      that it dials without confirming.

      ANSWER_PHONE_CALLS is what allows TelecomManager.endCall from API 28; READ_PHONE_STATE
      is how the tool knows whether a call is already in progress before dialling over it.
    -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!--
      Changing system settings such as brightness and screen timeout. A special
      access grant held per app on its own settings screen, not a runtime dialog -
      `Settings.System.canWrite` is the only correct way to read it, since
      `checkSelfPermission` returns granted merely because of this declaration.

      The writable set is an allowlist in AndroidSystemSettingsWriter; a model
      inferring a key name from a sentence cannot know which keys are safe.
    -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!--
      Switching the phone to silent or vibrate. Android treats this as Do Not Disturb
      policy access: `setRingerMode` succeeds for normal without it and throws a
      SecurityException for the other two, which is exactly the sort of partial
      failure that reads as a broken tool.
    -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!--
      Lets the app resolve and open other apps by package name. Without this,
      queryable packages are limited on API 30+ and listApps/openApp would see
      almost nothing.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".MainApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:theme="@style/AppTheme"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>

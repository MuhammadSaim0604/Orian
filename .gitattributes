# Normalize line endings: LF in the repository, native in the working tree.
* text=auto eol=lf

# Windows-only scripts must keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
gradlew.bat text eol=crlf

# Unix scripts and the Gradle wrapper must keep LF
*.sh text eol=lf
gradlew text eol=lf

# Binary files - never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary
*.keystore binary
*.jks binary
*.apk binary
*.aab binary
*.so binary
*.dylib binary
*.zip binary

# Lockfiles: keep diffs quiet in reviews
pnpm-lock.yaml -diff linguist-generated=true

{
  "name": "@mobile-automation/native-automation",
  "version": "0.1.0",
  "description": "Typed React Native bridge to the Kotlin Automation Runtime",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@mobile-automation/shared-types": "workspace:*",
    "@mobile-automation/tool-sdk": "workspace:*",
    "@mobile-automation/workflow-schema": "workspace:*",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "react": "18.3.1",
    "react-native": "0.76.6"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.76"
  }
}

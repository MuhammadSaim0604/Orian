{
  "name": "@mobile-automation/workflow-engine",
  "version": "0.1.0",
  "description": "DAG workflow executor: node registry, branching, loops, variables, retry policy",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@mobile-automation/node-sdk": "workspace:*",
    "@mobile-automation/shared-types": "workspace:*",
    "@mobile-automation/workflow-schema": "workspace:*"
  }
}

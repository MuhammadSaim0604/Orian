{
  "name": "@mobile-automation/workflow-engine",
  "version": "0.1.0",
  "description": "DAG workflow executor: node registry, branching, loops, variables, retry policy",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@mobile-automation/node-sdk": "workspace:*",
    "@mobile-automation/shared-types": "workspace:*",
    "@mobile-automation/workflow-schema": "workspace:*",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@mobile-automation/android-nodes": "workspace:*",
    "@mobile-automation/core-nodes": "workspace:*"
  }
}
